{
  "name": "waterfall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "tsx scripts/export-data.ts",
    "predev": "pnpm data",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "pnpm data",
    "build": "tsc --noEmit && vite build",
